---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import '../styles/global.css';

const photos = await getCollection('gallery');
photos.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Photo Portfolio</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
  </head>
  <body>
    <header class="header">
      <h1>Snaps by Dave</h1>
    </header>

    <main class="gallery-grid">
      {photos.map(async (photo) => {
        // Astro 5 API: Render content using render(photo)
        const { Content } = await render(photo);
        const captionText = `${photo.data.title} ${photo.data.exif?.settings ? `— ${photo.data.exif.settings}` : ''}`;
        
        return (
          <article class="photo-card">
            <a 
              href={photo.data.cover.src} 
              class="glightbox" 
              data-gallery="portfolio"
              data-title={photo.data.title}
              data-description={captionText}
            >
              <Image 
                src={photo.data.cover} 
                alt={photo.data.alt} 
                width={800} 
                format="webp" 
                class="thumbnail"
              />
            </a>
            
            <div class="meta">
              <h2>{photo.data.title}</h2>
              {photo.data.exif && (
                <p class="exif">
                  {photo.data.exif.camera} • {photo.data.exif.settings}
                </p>
              )}
              <div class="description">
                <Content />
              </div>
            </div>
          </article>
        );
      })}
    </main>

    <script is:inline src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    <script is:inline>
      const lightbox = GLightbox({
        selector: '.glightbox',
        touchNavigation: true,
        loop: true,
        zoomable: true
      });
    </script>
  </body>
</html>