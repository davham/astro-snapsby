---
import Navigation from '../components/Navigation.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import '../styles/global.css';

const gallery = await getCollection('gallery');
gallery.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Snaps by Dave</title>
  </head>
  <body>
    <Navigation />
    
    <main>
      <header class="header">
        <h1>Gallery</h1>
        <p>Recent photographs from the road, the woods, and everywhere in between.</p>
      </header>

      <section class="gallery-grid" aria-label="Photo gallery">
        {gallery.map((photo) => (
          <article class="photo-card">
            <Image
              class="thumbnail"
              src={photo.data.cover}
              alt={photo.data.alt}
              widths={[600, 900]}
              sizes="(max-width: 700px) 100vw, 50vw"
            />
            <div class="meta">
              <h2>{photo.data.title}</h2>
              <p class="exif">
                {photo.data.exif?.camera ?? 'Camera'} · {photo.data.date.toLocaleDateString()}
              </p>
            </div>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>